// Package quans follows each quan's event stream: load on open, reload on change, unmount on close.
package quans

import (
	"context"
	"errors"
	"log/slog"
	"sync"
	"time"

	"[[ .Name ]]/internal/config"
	"[[ .Name ]]/internal/eventstream"
	"[[ .Name ]]/internal/listeners"
	"[[ .Name ]]/internal/loader"
	"[[ .Name ]]/internal/process"
	"[[ .Name ]]/internal/wire"
)

type mounted struct {
	hash    string
	process *process.Process
}

// Status is a quan as /quans shows it.
type Status struct {
	Name      string   `json:"name"`
	Quas      []string `json:"quas"`
	State     string   `json:"state"`
	Detail    string   `json:"detail,omitempty"`
	PID       int      `json:"pid,omitempty"`
	Listening []string `json:"listening"`
}

// Service follows the quans of a quanar.
type Service struct {
	settings config.Settings
	mu       sync.Mutex
	mounted  map[string]mounted
	states   map[string][2]string
	locks    map[string]*sync.Mutex
}

// New makes a service for the quans in settings.
func New(settings config.Settings) *Service {
	s := &Service{settings: settings, mounted: map[string]mounted{}, states: map[string][2]string{}, locks: map[string]*sync.Mutex{}}
	for _, source := range settings.QuanSources {
		s.states[source.Name] = [2]string{"pending", ""}
		s.locks[source.Name] = &sync.Mutex{}
	}
	return s
}

func (s *Service) setState(name, state, detail string) {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.states[name][0] != state && state != "mounted" {
		slog.Warn(name+": "+state, "detail", detail)
	}
	s.states[name] = [2]string{state, detail}
}

func (s *Service) unmount(name, reason string) {
	s.mu.Lock()
	quan, ok := s.mounted[name]
	delete(s.mounted, name)
	s.mu.Unlock()
	if !ok {
		return
	}
	listeners.Forget(name)
	quan.process.Stop()
	slog.Warn(name+" unmounted", "reason", reason)
}

func (s *Service) mount(ctx context.Context, source config.QuanSource, program []byte, hash string) error {
	p, listens, err := process.Start(ctx, source, s.settings, program)
	if err != nil {
		return err
	}
	s.unmount(source.Name, "a new build arrived")
	for i, l := range listens {
		index := i
		forward := func(ctx context.Context, req wire.Request) (wire.Response, error) {
			return p.Request(ctx, index, req)
		}
		if err := listeners.Listen(source.Name, l.Method, l.Path, forward); err != nil {
			listeners.Forget(source.Name)
			p.Kill()
			return err
		}
	}
	s.mu.Lock()
	s.mounted[source.Name] = mounted{hash, p}
	s.mu.Unlock()
	p.OnExit = func(err error) {
		s.mu.Lock()
		current, ok := s.mounted[source.Name]
		if ok && current.process == p {
			delete(s.mounted, source.Name)
		}
		s.mu.Unlock()
		if ok && current.process == p {
			listeners.Forget(source.Name)
			s.setState(source.Name, "crashed", "process exited")
		}
	}
	s.setState(source.Name, "mounted", "")
	slog.Info(source.Name+" mounted", "pid", p.PID(), "listening", listeners.Listening(source.Name))
	return nil
}

func (s *Service) sync(ctx context.Context, source config.QuanSource) {
	lock := s.locks[source.Name]
	lock.Lock()
	defer lock.Unlock()
	fetchCtx, cancel := context.WithTimeout(ctx, s.settings.FetchTimeout)
	program, err := loader.Fetch(fetchCtx, source)
	cancel()
	var hash string
	if err == nil {
		hash, err = loader.Verify(source, program)
	}
	if err != nil {
		state := "unreachable"
		if errors.Is(err, loader.ErrHashMismatch) {
			state = "hash-mismatch"
		}
		s.setState(source.Name, state, err.Error())
		s.unmount(source.Name, state)
		return
	}
	s.mu.Lock()
	same := s.mounted[source.Name].hash == hash
	s.mu.Unlock()
	if same {
		return
	}
	if err := s.mount(ctx, source, program, hash); err != nil {
		s.setState(source.Name, "failed", err.Error())
		s.unmount(source.Name, "failed")
	}
}

func (s *Service) watch(ctx context.Context, source config.QuanSource) {
	if source.Events == "" {
		s.sync(ctx, source)
		return
	}
	for ctx.Err() == nil {
		eventstream.Follow(ctx, source.Events,
			func() { go s.sync(ctx, source) },
			func(name string) {
				if name == "change" {
					go s.sync(ctx, source)
				}
			})
		s.setState(source.Name, "unreachable", source.Events+" closed")
		s.unmount(source.Name, "its event stream closed")
		select {
		case <-ctx.Done():
		case <-time.After(s.settings.Reconnect):
		}
	}
}

// Start follows every quan until ctx ends.
func (s *Service) Start(ctx context.Context) {
	for _, source := range s.settings.QuanSources {
		go s.watch(ctx, source)
	}
}

// Stop unmounts every quan.
func (s *Service) Stop() {
	s.mu.Lock()
	names := make([]string, 0, len(s.mounted))
	for name := range s.mounted {
		names = append(names, name)
	}
	s.mu.Unlock()
	for _, name := range names {
		s.unmount(name, "quanar stopping")
	}
}

// Statuses lists every quan's state.
func (s *Service) Statuses() []Status {
	s.mu.Lock()
	defer s.mu.Unlock()
	out := []Status{}
	for _, source := range s.settings.QuanSources {
		st := Status{Name: source.Name, Quas: source.Quas, State: s.states[source.Name][0], Detail: s.states[source.Name][1], Listening: listeners.Listening(source.Name)}
		if m, ok := s.mounted[source.Name]; ok {
			st.PID = m.process.PID()
		}
		out = append(out, st)
	}
	return out
}
