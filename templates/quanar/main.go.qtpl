// The quanar: one server process. It holds no business logic. It loads quans at runtime, runs
// each in its own process and does the work they ask for through the qua.
package main

import (
	"context"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"[[ .Name ]]/gate"
	"[[ .Name ]]/internal/config"
	"[[ .Name ]]/internal/httpapp"
	"[[ .Name ]]/internal/quans"
	"[[ .Name ]]/internal/system"
)

func main() {
	// Started as a quan's gate: close the walls and become the quan.
	if gate.Main() {
		return
	}
	settings := config.Load()
	if !gate.Walled {
		slog.Warn("quans run without walls on this operating system: no file, network or memory limits")
	}
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	service := quans.New(settings)
	server := &http.Server{Addr: fmt.Sprintf(":%d", settings.Port), Handler: httpapp.New(system.Routes(service))}
	go func() {
		slog.Info(fmt.Sprintf("listening on http://localhost:%d", settings.Port))
		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			slog.Error("server", "error", err)
			stop()
		}
	}()
	service.Start(ctx)

	<-ctx.Done()
	slog.Info("stopping")
	service.Stop()
	shutdown, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	_ = server.Shutdown(shutdown)
}
